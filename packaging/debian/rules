#!/usr/bin/make -f

export CARGO_HOME = $(CURDIR)/debian/cargo-home

%:
	dh $@

# The crates come as the orig-vendor component, which unpacks into vendor/ with the cargo
# configuration that points at them. The source package leaves out their Cargo.toml.orig
# files, which cargo would check against each crate's list of file checksums; the crate's
# own sum stays.
override_dh_auto_configure:
	mkdir -p .cargo
	sed 's|^directory = .*|directory = "vendor/vendor"|' vendor/.cargo/config.toml > .cargo/config.toml
	find vendor/vendor -name .cargo-checksum.json -print0 | xargs -0 sed -i 's/"files":{[^}]*}/"files":{}/'

override_dh_auto_build:
	cargo build --release --offline --locked --workspace

# CI runs the tests on every change; the package build does not compile everything twice.
override_dh_auto_test:

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/leyen JUST_TEMPDIR=$(CURDIR)/debian just prefix=/usr install
	# The install recipe refreshes the caches even when staged; dpkg's triggers own them.
	rm -f debian/leyen/usr/share/glib-2.0/schemas/gschemas.compiled \
	  debian/leyen/usr/share/applications/mimeinfo.cache \
	  debian/leyen/usr/share/icons/hicolor/icon-theme.cache
