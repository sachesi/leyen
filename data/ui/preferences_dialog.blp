using Gtk 4.0;
using Adw 1;

template $LeyenPreferencesDialog: Adw.PreferencesDialog {
  content-width: 520;
  content-height: 620;
  closed => $on_closed() swapped;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("Default Paths");

      Adw.EntryRow prefix_row {
        title: _("Default Prefix Path");

        [suffix]
        Button {
          icon-name: "folder-open-symbolic";
          tooltip-text: _("Browse for prefix folder");
          valign: center;
          clicked => $on_browse_prefix() swapped;

          styles [
            "flat",
          ]
        }
      }

      Adw.ComboRow proton_row {
        title: _("Default Proton");
      }
    }

    $LeyenPrefixToolsGroup tools_group {
      description: _("Manage the default prefix inherited by games and groups.");
    }

    Adw.PreferencesGroup {
      title: _("Global Environment");
      description: _("What a new game starts with. Each game keeps its own switches, in its settings.");

      Adw.SwitchRow mangohud_row {
        title: _("MangoHud");
      }

      Adw.SwitchRow wayland_row {
        title: _("Wayland");
      }

      Adw.SwitchRow wow64_row {
        title: _("WoW64");
      }

      Adw.SwitchRow ntsync_row {
        title: _("NTSync");
      }

      Adw.SwitchRow hdr_row {
        title: _("HDR");
      }

      Adw.SwitchRow proton_log_row {
        title: _("Proton Log");
      }
    }

    Adw.PreferencesGroup {
      title: _("Sandbox");
      description: _("Games always run confined to their prefix and their own folder. What they may reach besides is set here, and each group and game can answer for itself.");

      Adw.SwitchRow sandbox_network_row {
        title: _("Network Access");
        subtitle: _("Let games reach the network. Online games need it; a game that has no business on the network can be cut off in its own settings.");
      }

      $LeyenSandboxFoldersRow folders_row {}
    }

    Adw.PreferencesGroup {
      title: _("Logging");
      description: _("Which of Leyen's own messages the log keeps. What games print is always kept.");

      Adw.SwitchRow log_errors_row {
        title: _("Errors");
        subtitle: _("Show error messages from leyen and launched processes");
      }

      Adw.SwitchRow log_warnings_row {
        title: _("Warnings");
        subtitle: _("Show warning messages (e.g. game not found)");
      }

      Adw.SwitchRow log_operations_row {
        title: _("Operations");
        subtitle: _("Show info about background operations");
      }
    }

    Adw.PreferencesGroup {
      title: _("Maintenance");

      Adw.ExpanderRow {
        title: _("Repair Runtime");
        subtitle: _("Reset internal umu-launcher components if dependency installation fails.");

        Adw.ActionRow {
          title: _("Reset umu Runtime");
          subtitle: _("Deletes steamrt3 directory. It will be re-downloaded on next dependency install.");

          [suffix]
          Button {
            label: _("Reset");
            valign: center;
            clicked => $on_reset_runtime() swapped;

            styles [
              "destructive-action",
            ]
          }
        }
      }
    }
  }
}
